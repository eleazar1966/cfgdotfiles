# Configuración global de Mako
default-timeout=3000
ignore-timeout=1

# Dimensiones y posición
anchor=top-right
font=sans-serif 10
width=300
margin=20
padding=15

# Bordes redondeados
border-radius=8
border-size=2

# COLORES DINÁMICOS (Verifica que estén escritos tal cual)
#background-color=#{{colors.surface.hex_stripped}}cc
#text-color=#{{colors.on_surface.hex_stripped}}ff
#border-color=#{{colors.primary.hex_stripped}}ff

# Estilo para las barras de progreso
#progress-color=source #{{colors.primary.hex_stripped}}ff
