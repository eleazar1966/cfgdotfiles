// Importación del bloque layout generado por Matugen (Colores y Gradiente)
include "colors.kdl"

prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us,es"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

cursor {
    xcursor-theme "Dracula-cursors"
    xcursor-size 24
}

layout {
    gaps 2
    center-focused-column "on-overflow"
    border {
        width 2
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
}

// --- SERVICIOS Y APLICACIONES AL ARRANQUE ---
spawn-at-startup "mako"
spawn-at-startup "dbus-update-activation-environment --all"
spawn-at-startup "dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri"
spawn-at-startup "/usr/libexec/xdg-desktop-portal" "-r"
spawn-at-startup "/usr/libexec/xdg-desktop-portal-gtk" "-r"
spawn-at-startup "pipewire"
spawn-at-startup "wireplumber"
spawn-at-startup "pipewire-pulse"
spawn-at-startup "udiskie" "-s"
spawn-at-startup "blueman-applet"
spawn-at-startup "sh" "-c" "openrgb --startminimized" 
spawn-at-startup "nm-applet" "--indicator"
// Scripts de gestión (Rutas absolutas usando expansión de shell)
spawn-at-startup "sh" "-c" "~/.local/bin/wallpapers.sh"
spawn-at-startup "sh" "-c" "~/.local/bin/launch-waybar.sh"

// Desactiva pantalla ayuda hotkeys
hotkey-overlay {
    skip-at-startup
}

layer-rule {
    match namespace="^launcher$"

    background-effect {
        blur true
        xray false
    }
}


window-rule {
    match app-id="floating_terminal"
    open-floating true
    default-column-width {
        proportion 0.3
    }
    default-window-height {
        proportion 0.4
    }
}

window-rule {
    match app-id="vlc"
    
    // Fuerza a VLC a abrir de forma flotante
    open-floating true
    
    // Establece el ancho al 50% de la pantalla
    default-column-width { proportion 0.5; }
    
    // Establece el alto al 50% de la pantalla
    default-window-height { proportion 0.5; }
}


window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// --- ATAJOS DE TECLADO (BINDS) ---
binds {
    // Teclas de Sistema y Aplicaciones
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "thunar"; }
    Mod+G { spawn "gimp" "-s"; }
    Mod+Q { close-window; }
    Mod+T { spawn "telegram-desktop" "-startintray"; }
    Mod+X { quit; }
    Mod+V { toggle-window-floating; }
    Mod+M { spawn "~/.local/bin/kitty-moc"; }
    // Teclado y Notificaciones
    Mod+Space { switch-layout "next"; }
    Mod+Shift+Space { spawn "makoctl" "dismiss"; }
    Mod+Control+Space { spawn "makoctl" "dismiss" "-a"; }
    Mod+Alt+Space { spawn "makoctl" "restore"; }

    // Scripts y Utilidades
    Mod+Shift+W { spawn "~/.local/bin/wallpapers.sh" "once"; }
    Mod+W { spawn "sh" "-c" "killall waybar && ~/.local/bin/launch-waybar.sh"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Alt+R { spawn "kitty" "--class" "floating_terminal" "-e" "~/.local/bin/graba_video.sh"; }

    // --- CAPTURAS DE PANTALLA (CORREGIDAS) ---
    // Captura de pantalla completa
    Print { 
        spawn "sh" "-c" "mkdir -p ~/Imágenes/Screenshot && grim ~/Imágenes/Screenshot/screenshot_$(date +%Y%m%d_%H%M%S).png" 
    }
    // Captura de región a archivo
    Mod+Print { 
        spawn "sh" "-c" "mkdir -p ~/Imágenes/Screenshot && grim -g \"$(slurp)\" ~/Imágenes/Screenshot/area_$(date +%Y%m%d_%H%M%S).png" 
    }
    // Captura de región al portapapeles (Mod+Shift+S)
    Mod+Shift+S { 
        spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy" 
    }

    // --- NAVEGACIÓN Y FOCO (HJKL) ---
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+O { toggle-overview; }

    // --- ESPACIOS DE TRABAJO (WORKSPACES) ---
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }

    // --- CONTROL DE VENTANAS Y LAYOUT ---
    Mod+BracketLeft { consume-window-into-column; }
    Mod+BracketRight { expel-window-from-column; }
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    // Redimensionado Horizontal
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    
    // Redimensionado Vertical
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // --- MULTIMEDIA ---
    // Control de volumen global PipeWire + Alertas Mako
    XF86AudioRaiseVolume { spawn "~/.local/bin/volume-notify" "up"; }
    XF86AudioLowerVolume { spawn "~/.local/bin/volume-notify" "down"; }
    XF86AudioMute        { spawn "~/.local/bin/volume-notify" "mute"; }

    // Atajo personalizado para el Micrófono (Super + N)
    Mod+N                { spawn "~/.local/bin/volume-notify" "mic"; }

    //XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    //XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    //XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    // Silenciar / Activar el micrófono global en PipeWire
    //Mod+N { spawn "sh" "-c" "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && notify-send -h string:x-canonical-private-synchronous:mic -i microphone-sensitivity-muted 'Micrófono' '$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo DESACTIVADO || echo ACTIVO)'"; }
    // Teclas multimedia dedicadas para el control de pistas
    XF86AudioPlay  { spawn "mocp" "-G"; } // Alterna entre Reproducir y Pausar (Toggle)
    XF86AudioNext  { spawn "mocp" "-f"; } // Siguiente canción (Forward)
    XF86AudioPrev  { spawn "mocp" "-r"; } // Canción anterior (Reverse)
    XF86AudioStop  { spawn "mocp" "-s"; } // Detener música por completo (Stop)

}
