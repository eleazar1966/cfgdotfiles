prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us,es"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

cursor {
    xcursor-theme "Dracula-cursors"
    xcursor-size 10
}

layout {
    gaps 2
    center-focused-column "on-overflow"

    focus-ring {
        width 2
        active-gradient from="#80c8ff" to="#c7ff7f" angle=45
        inactive-color "#505050"
    }

    border {
        width 2
        active-gradient from="#c7ff7f" to="#80c8ff" angle=45
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
}

// --- SERVICIOS Y APLICACIONES ---
spawn-at-startup "swww-daemon"
spawn-at-startup "pipewire"
spawn-at-startup "udiskie" "-s"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
// Restauración de OpenRGB (modo minimizado/server según prefieras)
spawn-at-startup "openrgb" "--startminimized"

// Scripts de gestión
spawn-at-startup "/home/eleazar/.local/share/systools/launch-waybar.sh"
spawn-at-startup "sh" "-c" "sleep 2 && /home/eleazar/.local/share/systools/mostrar_imagenes.sh"

hotkey-overlay {
    skip-at-startup
}

// --- REGLAS DE VENTANA ---
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "thunar"; }
    Mod+Q { close-window; }
    Mod+X { quit; }
    Mod+V { toggle-window-floating; }
    
    // Restauración de cambio de Layout de teclado
    Mod+Space { switch-layout "next"; }
    
    Mod+Shift+W { spawn "/home/eleazar/.local/share/systools/mostrar_imagenes.sh"; }
    Mod+W { spawn "/home/eleazar/.local/share/systools/launch-waybar.sh"; }
    Mod+D { spawn "/home/eleazar/.local/share/systools/launch-rofi.sh"; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }

    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
}
