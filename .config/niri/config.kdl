// --- INTEGRACIÓN CROMÁTICA AUTOMATIZADA ---
include "colors.kdl"

prefer-no-csd

// =============================================================================
// 1. CONFIGURACIÓN DE DISPOSITIVOS DE ENTRADA (INPUT BLOCK)
// =============================================================================
input {
    keyboard {
        xkb {
            layout "us,es"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

cursor {
    xcursor-theme "Dracula-cursors"
    xcursor-size 24
}

// =============================================================================
// 2. GEOMETRÍA Y REGLAS DE DISEÑO (LAYOUT BLOCK)
// =============================================================================
layout {
    gaps 2
    center-focused-column "on-overflow"
    
    preset-column-widths {
        proportion 0.333
        proportion 0.5
        proportion 0.667
    }
    default-column-width { proportion 0.5; }

    border {
        width 2
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
    
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

hotkey-overlay {                                                                
    skip-at-startup                                                             
}    

// =============================================================================
// 3. CAPTURAS DE PANTALLA NATIVAS (DIRECTORIO PERSONALIZADO)
// =============================================================================
screenshot-path "~/Imágenes/Screenshot/Screenshot desde %Y-%m-%d %H-%M-%S.png"

// =============================================================================
// 4. SERVICIOS Y APLICACIONES AL ARRANQUE
// =============================================================================
spawn-at-startup "mako"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP=niri"
spawn-at-startup "sh" "-c" "pkill xdg-desktop-portal; /usr/libexec/xdg-desktop-portal &"
spawn-at-startup "/usr/libexec/lxqt-policykit-agent"
spawn-at-startup "/home/eleazar/.local/bin/wallpapers.sh"
spawn-at-startup "/home/eleazar/.local/bin/launch-waybar.sh"

// =============================================================================
// 5. DESPACHADOR DE ATAJOS DE TECLADO (BINDS BLOCK)
// =============================================================================
binds {
    // --- LANZADORES DEL ENTORNO ---
    Mod+Return       { spawn "kitty"; }
    Mod+D            { spawn "fuzzel"; }
    Mod+E            { spawn "thunar"; }
    Mod+T            { spawn "env" "QT_QPA_PLATFORM=xcb" "telegram-desktop"; }
    Mod+M            { spawn "/home/eleazar/.local/bin/kitty-moc"; }
    Mod+Shift+M      { spawn "sh" "-c" "mocp -x; pkill -f cava; pkill -f 'kitty.*--title Música'"; }
    Mod+Y            { spawn "kitty" "--class" "floating_terminal" "-e" "yt-x"; }

    // --- GESTIÓN DINÁMICA DE IDIOMAS (TECLADO) ---
    Mod+Space        { switch-layout "next"; }

    // --- FLUJO DE ENFOQUE DE VENTANAS ---
    Mod+H            { focus-column-left; }
    Mod+Left         { focus-column-left; }
    Mod+L            { focus-column-right; }
    Mod+Right        { focus-column-right; }
    Mod+J            { focus-window-down; }
    Mod+Down         { focus-window-down; }
    Mod+K            { focus-window-up; }
    Mod+Up           { focus-window-up; }
    
    Mod+V            { toggle-window-floating; }
    Mod+Shift+V      { switch-focus-between-floating-and-tiling; }
    Mod+Home         { focus-column-first; }
    Mod+End          { focus-column-last; }
    Mod+O            { toggle-overview; }

    // --- REORGANIZACIÓN DE CONTENEDORES ---
    Mod+Shift+H      { move-column-left; }
    Mod+Shift+Left   { move-column-left; }
    Mod+Shift+L      { move-column-right; }
    Mod+Shift+Right  { move-column-right; }
    Mod+Shift+J      { move-window-down; }
    Mod+Shift+Down   { move-window-down; }
    Mod+Shift+K      { move-window-up; }
    Mod+Shift+Up     { move-window-up; }
    Mod+Shift+Home   { move-column-to-first; }
    Mod+Shift+End    { move-column-to-last; }

    // --- ESPACIOS DE TRABAJO (WORKSPACES) ---
    Mod+Page_Down    { focus-workspace-down; }
    Mod+U            { focus-workspace-down; }
    Mod+Page_Up      { focus-workspace-up; }
    Mod+I            { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // --- NAVEGACIÓN CON RUEDA DEL RATÓN (CONVENIENTES POR DEFECTO) ---
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // --- CONTROL DE VENTANAS Y LAYOUT ---
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }
    Mod+W            { toggle-column-tabbed-display; }

    // --- DIMENSIONAMIENTO Y ESCALADO ---
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+C            { center-column; }

    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }

    // --- CAPTURA DE PANTALLA NATIVA ---
    Print            { screenshot; }
    Ctrl+Print       { screenshot-screen; }
    Alt+Print        { screenshot-window; }

    // --- MULTIMEDIA Y CONTROLES DE AUDIO ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn "~/.local/bin/volume-notify" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "~/.local/bin/volume-notify" "down"; }
    XF86AudioMute        allow-when-locked=true { spawn "~/.local/bin/volume-notify" "mute"; }
    Mod+N                allow-when-locked=true { spawn "~/.local/bin/volume-notify" "mic"; }

    // Controles de reproducción adicionales por defecto (Playerctl)
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }

    // --- SCRIPTS DE AUTOMATIZACIÓN ---
    Mod+G                { spawn "/home/eleazar/.local/bin/graba_video.sh"; }
    Mod+Shift+W          { spawn "/home/eleazar/.local/bin/wallpapers.sh" "next"; }

    // --- SEGURIDAD Y CONTROL DE SESIÓN ---
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Q            { close-window; }
    Mod+Shift+P      { power-off-monitors; }
    Mod+Shift+E      { quit; }
    Ctrl+Alt+Delete  { quit; }

    // --- INTEGRACIÓN DE AYUDA PERSONALIZADA EN ESPAÑOL ---
    Mod+Slash        { spawn "/home/eleazar/.local/bin/ayuda-niri.sh"; }
    Mod+Shift+Slash  { spawn "/home/eleazar/.local/bin/ayuda-niri.sh"; }
}

// =============================================================================
// 6. REGLAS DE VENTANAS Y REDONDEO MÍNIMO (WINDOW RULES)
// =============================================================================
// Redondeo sutil de esquinas para todas las ventanas del sistema
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

window-rule {
    match app-id="niri_help"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.7; }
}

window-rule {
    match is-active=false
    match is-floating=true
    opacity 0.95
}

window-rule {
    match app-id="floating_terminal"
    open-floating true
    default-column-width { proportion 0.3; }
    default-window-height { proportion 0.4; }
}
