// Importación directa del bloque layout generado por Matugen
include "colors.kdl"
prefer-no-csd
input {
    keyboard {
        xkb {
            layout "us,es"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}
cursor {
    xcursor-theme "Dracula-cursors"
    xcursor-size 24
}
// Aquí puedes añadir otras opciones de layout si las necesitas,
// pero los colores ya vienen del include "colors.kdl"
layout {
    gaps 2
    center-focused-column "on-overflow"
    border {
        width 2
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
}
// --- RESTO DE TU CONFIGURACIÓN (spawn-at-startup, binds, etc.) ---
spawn-at-startup "swww-daemon"
spawn-at-startup "mako"
spawn-at-startup "/home/eleazar/.local/share/systools/launch-waybar.sh"
spawn-at-startup "/home/eleazar/.local/share/systools/mostrar_imagenes.sh"
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
binds {
    Mod+Return {
        spawn "kitty"
    }
    Mod+Q {
        close-window
    }
    Mod+X {
        quit
    }
    Mod+Shift+W {
        spawn "/home/eleazar/.local/share/systools/mostrar_imagenes.sh" "once"
    }
    // Navegación HJKL
    Mod+H {
        focus-column-left
    }
    Mod+J {
        focus-window-down
    }
    Mod+K {
        focus-window-up
    }
    Mod+L {
        focus-column-right
    }
}

