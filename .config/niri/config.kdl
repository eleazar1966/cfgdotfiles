prefer-no-csd

input {
    keyboard {
        xkb {
             layout "us,es"
             options "grp:win_space_toggle,compose:ralt"
        }
    }
    touchpad { 
        accel-profile "flat" 
    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

cursor {
    xcursor-theme "Dracula-cursors"
    xcursor-size 10
}

output "DP-1" {
    mode "1366x768@59.790"
    scale 1.0
    transform "normal"
    position x=0 y=0
}

layout {
    gaps 2
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    
    focus-ring {
        width 2
        active-color "#80c8ff"
        inactive-color "#505050"
    }
    border {
        width 2
        active-color "#e5989b"
        inactive-color "#333333"
    }
    shadow {
        on
        draw-behind-window true
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

// --- ARRANQUE ---
spawn-at-startup "niri" "msg" "action" "show-hotkey-overlay" "--hide"
spawn-at-startup "waybar"
spawn-at-startup "swww-daemon"
spawn-at-startup "pipewire"
spawn-at-startup "udiskie" "-s"
spawn-at-startup "openrgb" "--startminimized"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
spawn-at-startup "sh" "-c" "~/.local/share/systools/mostrar_imagenes.sh"

hotkey-overlay {
     skip-at-startup // Descomentar para deshabilitar la ventana emergente de "Atajos Importantes" al inicio.
}


binds {
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "thunar"; }
    Mod+Q repeat=false { close-window; }
    Mod+X { spawn "sh" "-c" "rm -f /run/user/1000/wayland-* && niri msg action quit"; }
    
    // Cambio manual de wallpaper
    Mod+Shift+W { spawn "sh" "-c" "kill -USR1 $(cat /tmp/mostrar_imagenes.pid)"; }

    // Navegación
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+V { toggle-window-floating; }
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

include "colors.kdl"
