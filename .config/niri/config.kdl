include "colors.kdl"
prefer-no-csd
input {
    keyboard {
        xkb {
            layout "us,es"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}
cursor {
    xcursor-theme "Dracula-cursors"
    xcursor-size 24
}
layout {
    gaps 2
    center-focused-column "on-overflow"
    border {
        width 2
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
}
// --- SECCIÓN DE ANIMACIONES CORREGIDA ---
animations {
    // Para apertura, usamos spring (física) sin definir 'curve'
    window-open {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
    // Para cierre, usamos una curva soportada: ease-out-cubic
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
    // Movimientos internos: ease-out-expo es la más fluida disponible
    window-movement {
        duration-ms 250
        curve "ease-out-expo"
    }
    // Cambio de workspace
    workspace-switch {
        duration-ms 400
        curve "ease-out-expo"
    }
}
// --- SERVICIOS Y APLICACIONES AL ARRANQUE ---
spawn-at-startup "mako"
spawn-at-startup "swww-daemon"
spawn-at-startup "udiskie" "-s"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
spawn-at-startup "openrgb" "--startminimized"
spawn-at-startup "pipewire"
spawn-at-startup "wireplumber"
spawn-at-startup "/home/eleazar/.local/share/systools/launch-waybar.sh"
spawn-at-startup "/home/eleazar/.local/share/systools/mostrar_imagenes.sh"
spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1"
hotkey-overlay {
    skip-at-startup
}
window-rule {
    match app-id="floating_terminal"
    open-floating true
    default-column-width {
        proportion 0.3
    }
    default-window-height {
        proportion 0.4
    }
}
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
// --- ATAJOS DE TECLADO (BINDS) ---
binds {
    Mod+Shift+Slash {
        show-hotkey-overlay
    }
    Mod+Return {
        spawn "kitty"
    }
    Mod+E {
        spawn "thunar"
    }
    Mod+Q {
        close-window
    }
    Mod+X {
        quit
    }
    Mod+V {
        toggle-window-floating
    }
    Mod+Space {
        switch-layout "next"
    }
    Mod+Shift+Space {
        spawn "makoctl" "dismiss"
    }
    Mod+Control+Space {
        spawn "makoctl" "dismiss" "-a"
    }
    Mod+Alt+Space {
        spawn "makoctl" "restore"
    }
    Mod+Shift+W {
        spawn "/home/eleazar/.local/share/systools/mostrar_imagenes.sh" "once"
    }
    Mod+W {
        spawn "sh" "-c" "killall waybar"
    }
    Mod+D {
        spawn "/home/eleazar/.local/share/systools/launch-rofi.sh"
    }
    Mod+Alt+R {
        spawn "kitty" "--class" "floating_terminal" "-e" "/home/eleazar/.local/share/systools/graba_video.sh"
    }
    Print {
        spawn "sh" "-c" "mkdir -p ~/Imágenes/Screenshot && grim ~/Imágenes/Screenshot/screenshot_$(date +%Y%m%d_%H%M%S).png"
    }
    Mod+Print {
        spawn "sh" "-c" "mkdir -p ~/Imágenes/Screenshot && grim -g \"$(slurp)\" ~/Imágenes/Screenshot/area_$(date +%Y%m%d_%H%M%S).png"
    }
    Mod+Shift+S {
        spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"
    }
    Mod+H {
        focus-column-left
    }
    Mod+J {
        focus-window-down
    }
    Mod+K {
        focus-window-up
    }
    Mod+L {
        focus-column-right
    }
    Mod+Shift+H {
        move-column-left
    }
    Mod+Shift+J {
        move-window-down
    }
    Mod+Shift+K {
        move-window-up
    }
    Mod+Shift+L {
        move-column-right
    }
    Mod+Shift+V {
        switch-focus-between-floating-and-tiling
    }
    Mod+O {
        toggle-overview
    }
    Mod+Page_Down {
        focus-workspace-down
    }
    Mod+Ctrl+Page_Down {
        move-column-to-workspace-down
    }
    Mod+Ctrl+Page_Up {
        move-column-to-workspace-up
    }
    Mod+Page_Up {
        focus-workspace-up
    }
    Mod+BracketLeft {
        consume-window-into-column
    }
    Mod+BracketRight {
        expel-window-from-column
    }
    Mod+Comma {
        consume-or-expel-window-left
    }
    Mod+Period {
        consume-or-expel-window-right
    }
    Mod+1 {
        focus-workspace 1
    }
    Mod+2 {
        focus-workspace 2
    }
    Mod+3 {
        focus-workspace 3
    }
    Mod+4 {
        focus-workspace 4
    }
    Mod+5 {
        focus-workspace 5
    }
    Mod+6 {
        focus-workspace 6
    }
    Mod+7 {
        focus-workspace 7
    }
    Mod+8 {
        focus-workspace 8
    }
    Mod+9 {
        focus-workspace 9
    }
    Mod+Shift+1 {
        move-column-to-workspace 1
    }
    Mod+Shift+2 {
        move-column-to-workspace 2
    }
    Mod+Shift+3 {
        move-column-to-workspace 3
    }
    Mod+R {
        switch-preset-column-width
    }
    Mod+F {
        maximize-column
    }
    Mod+Shift+F {
        fullscreen-window
    }
    Mod+C {
        center-column
    }
    Mod+Minus {
        set-column-width "-10%"
    }
    Mod+Equal {
        set-column-width "+10%"
    }
    Mod+Shift+Minus {
        set-window-height "-10%"
    }
    Mod+Shift+Equal {
        set-window-height "+10%"
    }
    XF86AudioRaiseVolume {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"
    }
    XF86AudioLowerVolume {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"
    }
    XF86AudioMute {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    }
}

