// Importación de colores generados por Matugen
include "colors.kdl"

prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us,es"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

cursor {
    xcursor-theme "Dracula-cursors"
    xcursor-size 24
}

layout {
    gaps 2
    center-focused-column "on-overflow"

    focus-ring {
        width 2
        // El active-color se toma automáticamente de colors.kdl
        inactive-color "#505050"
    }

    border {
        width 2
        // El active-color se toma automáticamente de colors.kdl
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
}

// --- SERVICIOS Y APLICACIONES AL ARRANQUE ---
spawn-at-startup "mako"
spawn-at-startup "swww-daemon"
spawn-at-startup "pipewire"
spawn-at-startup "wireplumber"
spawn-at-startup "udiskie" "-s"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
spawn-at-startup "openrgb" "--startminimized"

// Scripts de gestión (Rutas absolutas)
spawn-at-startup "/home/eleazar/.local/share/systools/launch-waybar.sh"
spawn-at-startup "/home/eleazar/.local/share/systools/mostrar_imagenes.sh"

hotkey-overlay {
    skip-at-startup
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

binds {
    // Teclas de Sistema y Ayuda
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "thunar"; }
    Mod+Q { close-window; }
    Mod+X { quit; }
    Mod+V { toggle-window-floating; }
    
    // Teclado y Notificaciones
    Mod+Space { switch-layout "next"; }
    Mod+Shift+Space { spawn "makoctl" "dismiss"; }
    Mod+Control+Space { spawn "makoctl" "dismiss" "-a"; }
    Mod+Alt+Space { spawn "makoctl" "restore"; }

    // Acciones de Scripts (Tus herramientas personalizadas)
    Mod+Shift+W { spawn "/home/eleazar/.local/share/systools/mostrar_imagenes.sh" "once"; }
    Mod+W { spawn "/home/eleazar/.local/share/systools/launch-waybar.sh"; }
    Mod+D { spawn "/home/eleazar/.local/share/systools/launch-rofi.sh"; }

    // Navegación de Ventanas (HJKL)
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // Espacios de Trabajo
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }

    // Layout y Pantalla Completa
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
}
