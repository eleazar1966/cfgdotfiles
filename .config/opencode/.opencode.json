{
  "$schema": "https://opencode.ai/config.json",
  "data": {
    "directory": ".opencode"
  },
  "providers": {
    "openrouter": {
      "apiKey": "${OPENROUTER_API_KEY}",
      "disabled": false
    },
    "gemini": {
      "apiKey": "${GEMINI_API_KEY}",
      "disabled": false
    },
    "together": {
      "apiKey": "${TOGETHER_API_KEY}",
      "disabled": false
    }
  },
  "agents": {
    "coder": {
      "model": "openrouter.deepseek-r1-free",
      "maxTokens": 10000
    },
    "summarizer": {
      "model": "openrouter.deepseek-r1-free",
      "maxTokens": 10000
    },
    "task": {
      "model": "openrouter.deepseek-r1-free",
      "maxTokens": 10000
    },
    "title": {
      "model": "openrouter.deepseek-r1-free",
      "maxTokens": 80
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.aws/credentials": "deny",
      "**/.config/gh/hosts.yml": "deny",
      "**/.credentials/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
      "**/Library/Keychains/**": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },
  "share": "disabled",
  "autoCompact": true
}