* {
  bg0     : #0f1512CC;
  bg1     : #1b211eCC;
  bg2     : #404944;
  bg3     : #89938d;
  fg0     : #dee4df;
  accent  : #8ad6b6;
  font: "Iosevka Nerd Font Medium 11";
  background-color : transparent;
  text-color       : @fg0;
  margin: 0;
  padding: 0; 
  spacing: 0;
}

window {
  location : northwest;
  width    : 280px;
  x-offset : 4px;
  y-offset : 26px;
  background-color: @bg0;
  border: 1px; border-color: @bg3; border-radius: 6px;
}

inputbar {
  spacing: 8px; padding: 4px 8px;
  background-color: @bg1;
  children: [ icon-search, entry ];
}

icon-search {
  expand: false; filename: "search-symbolic"; size: 14px;
  vertical-align: 0.5;
}

listview {
  padding: 4px 0px; lines: 12; columns: 1;
  scrollbar: true; fixed-height: false; dynamic: true;
}

element {
  padding: 4px 8px; spacing: 8px;
}

element selected {
  background-color: @accent;
  text-color: @bg0;
  border-radius: 4px;
}

element-icon { size: 1.0em; }

element-text {
  text-color: inherit; vertical-align: 0.5;
}
