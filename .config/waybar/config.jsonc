{
  "height": 28,
  "spacing": 0,
  "modules-left": [
    "custom/menu",
    "custom/opera",
    "custom/pcmanfm",
    "custom/thunar",
    "custom/firefox",
    "custom/thunderbird",
    "custom/TelegramDesktop",
    "custom/mousepad",
    "custom/terminal",
    "custom/calculadora",
    "custom/localsend",
    "wlr/taskbar"
  ],
  "modules-center": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-right": [
    "bluetooth",
    "keyboard-state",
    "wireplumber",
    "cpu",
    "memory",
    "temperature",
    "custom/language",
    "clock",
    "tray",
    "custom/power"
  ],
  "niri/workspaces": {
    "format": "{name}",
    "all-outputs": true
  },
  "niri/window": {
    "format": "{title}",
    "separate-outputs": true
  },
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": {
      "numlock": "{icon}N",
      "capslock": "{icon}C"
    },
    "format-icons": {
      "locked": "  ",
      "unlocked": ""
    }
  },
  "custom/language": {
    "interval": 1,
    //"exec": "niri msg -j keyboard-layouts | jq -r '.names[.current_idx]' | sed 's/English (US)/EN 🇺🇸/;s/Spanish/ES 🇪🇸/'",
    "exec": "niri msg -j keyboard-layouts | jq -r '.names[.current_idx]' | sed 's/English (US)/EN/;s/Spanish/ES/'",
    "format": "  {}",
    "on-click": "niri msg action switch-layout next",
    "tooltip": false
  },
  "cpu": {
    "format": "{usage}% ",
    "on-click": "kitty -e btop"
  },
  "memory": {
    "format": "{}% ",
    "on-click": "kitty -e btop"
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "kitty -e watch sensors"
  },
  "clock": {
    "format": "{:L%a, %d %b, %Y (%I:%M %p)}  ",
    "on-click": "kitty --class floating_cal -e sh -c 'cal; read'"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10
  },
  "custom/power": {
    "format": "⏻ ",
    "on-click": "niri msg action quit"
  },
  "custom/menu": {
    "format": " ",
    "on-click": "rofi -show drun"
  },
  "custom/opera": {
    "format": "󰖟 ",
    "on-click": "opera --private"
  },
  "custom/pcmanfm": {
    "format": "󱂶 ",
    "on-click": "pcmanfm"
  },
  "custom/thunar": {
    "format": " ",
    "on-click": "thunar"
  },
  "custom/firefox": {
    "format": " ",
    "on-click": "firefox"
  },
  "custom/thunderbird": {
    "format": " ",
    "on-click": "thunderbird"
  },
  "custom/TelegramDesktop": {
    "format": " ",
    "on-click": "Telegram"
  },
  "custom/mousepad": {
    "format": "󱞁 ",
    "on-click": "mousepad"
  },
  "custom/terminal": {
    "format": " ",
    "on-click": "kitty"
  },
  "custom/calculadora": {
    "format": "󱖦 ",
    "on-click": "gnome-calculator"
  },
  "custom/localsend": {
    "format": "󰈪 ",
    "on-click": "/opt/LocalSend-1.17.0-linux-x86-64/localsend_app"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "on-click": "activate"
  },
  "bluetooth": {
    "format": "",
    "format-connected": " {device_alias}",
    "on-click": "blueman-manager",
    "on-click-right": "rfkill toggle bluetooth"
  }
}
