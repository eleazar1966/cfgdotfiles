{
  "height": 28,
  "spacing": 0,
  "modules-left": [
    "custom/menu",
    "custom/opera",
    "custom/pcmanfm",
    "custom/thunar",
    "custom/firefox",
    "custom/thunderbird",
    "custom/TelegramDesktop",
    "custom/mousepad",
    "custom/terminal",
    "custom/calculadora",
    "custom/localsend",
    "wlr/taskbar"
  ],
  "modules-center": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-right": [
    "bluetooth",
    "keyboard-state",
    "wireplumber",
    "cpu",
    "memory",
    "temperature",
    "custom/language",
    "clock",
    "tray",
    "custom/power"
  ],
  "niri/workspaces": {
    "format": "{name}",
    "all-outputs": true
  },
  "niri/window": {
    "format": "{title}",
    "separate-outputs": true
  },
  "custom/language": {
    "exec": "niri msg -j keyboard-layouts | jq -r '.names[.current_idx]' | sed 's/English (US)/EN/;s/Spanish/ES/'",
    "interval": 1,
    "format": "  {}",
    "on-click": "niri msg action switch-layout next",
    "tooltip": false
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "clock": {
    "locale": "es_ES.UTF-8",
    "format": "{:%I:%M %p %d/%m/%Y}  ",
    "format-alt": "{:%A, %B %d, %Y (%R)}  ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month", // Cambiado a mes por defecto
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click": "mode", // Click izquierdo: Mes actual
      "on-click-right": "mode", // Click derecho: Cicla a modo año
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/power": {
    "format": "⏻ ",
    "on-click": "niri msg action quit"
  },
  /* Iconos y aplicaciones */
  "custom/menu": {
    "format": " ",
    "on-click": "rofi -show drun"
  },
  "custom/opera": {
    "format": "󰖟 ",
    "on-click": "opera --private"
  },
  "custom/pcmanfm": {
    "format": "󱂶 ",
    "on-click": "pcmanfm"
  },
  "custom/thunar": {
    "format": " ",
    "on-click": "thunar"
  },
  "custom/firefox": {
    "format": " ",
    "on-click": "firefox"
  },
  "custom/thunderbird": {
    "format": " ",
    "on-click": "thunderbird"
  },
  "custom/TelegramDesktop": {
    "format": " ",
    "on-click": "Telegram"
  },
  "custom/mousepad": {
    "format": "󱞁 ",
    "on-click": "mousepad"
  },
  "custom/terminal": {
    "format": " ",
    "on-click": "kitty"
  },
  "custom/calculadora": {
    "format": "󱖦 ",
    "on-click": "gnome-calculator"
  },
  "custom/localsend": {
    "format": "󰈪 ",
    "on-click": "/opt/LocalSend-1.17.0-linux-x86-64/localsend_app"
  }
}
