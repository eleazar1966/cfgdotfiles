{
  "height": 28,
  "spacing": 0,
  "modules-left": [
    "custom/menu",
    "custom/opera",
    "custom/pcmanfm",
    "custom/thunar",
    "custom/firefox",
    "custom/thunderbird",
    "custom/TelegramDesktop",
    "custom/mousepad",
    "custom/terminal",
    "custom/calculadora",
    "custom/localsend",
    "wlr/taskbar"
  ],
  "modules-center": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-right": [
    "bluetooth",
    "keyboard-state",
    "wireplumber",
    "cpu",
    "memory",
    "temperature",
    "custom/language",
    "clock",
    "tray",
    "custom/power"
  ],
  "wlr/taskbar": {
    "format": "{icon}",
    "on-click": "activate",
    "on-click-right": "minimize",
    "on-click-middle": "close",
    /* Forzamos el uso de sh para asegurar la ejecución del comando */
    "on-scroll-up": "sh -c 'niri msg action focus-column-left'",
    "on-scroll-down": "sh -c 'niri msg action focus-column-right'",
    "all-outputs": true
  },
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "scrolllock": true,
    "format": {
      "numlock": "N {icon}",
      "capslock": "C {icon}",
      "scrolllock": "S {icon}"
    },
    "format-icons": {
      "locked": "󰌾",
      "unlocked": ""
    }
  },
  "cpu": {
    "interval": 10,
    "format": "{}% ",
    "max-length": 10
  },
  "memory": {
    "interval": 30,
    "format": "{}% ",
    "max-length": 10
  },
  "temperature": {
    "critical-threshold": 80,
    "format-critical": "{temperatureC}°C ",
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "wireplumber": {
    "format": "{volume}% {icon}",
    "format-muted": "",
    "on-click": "helvum",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "custom/language": {
    "exec": "niri msg -j keyboard-layouts | jq -r '.names[.current_idx]' | sed 's/English (US)/EN/;s/Spanish/ES/'",
    "interval": 1,
    "format": "  {}",
    "on-click": "niri msg action switch-layout next",
    "tooltip": false
  },
  "clock": {
    "locale": "es_ES.UTF-8",
    "timezone": "America/Caracas",
    "format": "{:%I:%M %p %d/%m/%Y}  ",
    "format-alt": "{:%A, %B %d, %Y (%R)}  ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click": "mode",
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "niri/workspaces": {
    "format": "{name}",
    "all-outputs": true
  },
  "custom/menu": {
    "format": " ",
    "on-click": "~/.local/share/systools/launch-rofi.sh"
  },
  "custom/opera": {
    "format": "󰖟 ",
    "on-click": "opera --private"
  },
  "custom/pcmanfm": {
    "format": "󱂶 ",
    "on-click": "pcmanfm"
  },
  "custom/thunar": {
    "format": " ",
    "on-click": "thunar"
  },
  "custom/firefox": {
    "format": " ",
    "on-click": "firefox --private-window"
  },
  "custom/thunderbird": {
    "format": " ",
    "on-click": "thunderbird"
  },
  "custom/TelegramDesktop": {
    "format": " ",
    "on-click": "Telegram"
  },
  "custom/mousepad": {
    "format": "󱞁 ",
    "on-click": "mousepad"
  },
  "custom/terminal": {
    "format": " ",
    "on-click": "kitty"
  },
  "custom/calculadora": {
    "format": "󱖦 ",
    "on-click": "gnome-calculator"
  },
  "custom/localsend": {
    "format": "󰈪 ",
    "on-click": "/opt/LocalSend-1.17.0-linux-x86-64/localsend_app"
  },
  "custom/power": {
    "format": "⏻ ",
    "on-click": "~/.config/waybar/power_menu.py"
  }
}
