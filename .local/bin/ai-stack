#!/bin/bash
# ai-stack — Lanza y gestiona Ollama + OpenClaw + OpenCode + Open WebUI
# Uso:  ai-stack [comando|servicio]   (sin args → menú interactivo)

set -euo pipefail

# ── Config ─────────────────────────────────────────────────────────────────
OPENCODE_BIN="${OPENCODE_BIN:-$HOME/.opencode/bin/opencode}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
AUTH_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/opencode"
OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"
OLLAMA_READY_TIMEOUT="${OLLAMA_READY_TIMEOUT:-60}"
CLIP_SYNC_PID=""

# ── Colores ────────────────────────────────────────────────────────────────
RST="\e[0m"; B="\e[1m"; D="\e[2m"
G="\e[32m"; Y="\e[33m"; C="\e[36m"; R="\e[31m"; M="\e[35m"

info()  { echo -e " ${C}→${RST} $*"; }
ok()    { echo -e " ${G}✓${RST} $*"; }
warn()  { echo -e " ${Y}⚠${RST} $*"; }
err()   { echo -e " ${R}✗${RST} $*"; }
title() { echo -e "\n${B}${1}${RST}"; d="${2:-}"; [ -n "$d" ] && echo -e " ${D}${d}${RST}"; echo; }

# ── Help ───────────────────────────────────────────────────────────────────
usage() {
  echo -e "${B}ai-stack${RST} — Gestiona servicios AI en Gentoo\n"
  echo -e "${B}Uso:${RST}  ai-stack [comando] [servicio]\n"
  echo -e "${B}Comandos:${RST}"
  echo "  status               Muestra estado de todos los servicios"
  echo "  start  <servicio>    Inicia un servicio (ollama|openclaw|webui|opencode)"
  echo "  stop   <servicio>    Detiene un servicio"
  echo "  restart <servicio>   Reinicia un servicio"
  echo "  legacy               Menú simplificado (3 opciones)"
  echo "  renew                Renovar token MCP de OpenClaw en opencode.json"
  echo "  code                 Ollama + OpenCode (combinación rápida)"
  echo "  mcp                  Ollama + OpenClaw"
  echo "  webui                Ollama + Open WebUI"
  echo "  full                 Todo el stack"
  echo
  echo -e "${B}Sin args:${RST} menú interactivo"
  echo -e "${B}Ejemplos:${RST}"
  echo "  ai-stack status"
  echo "  ai-stack start openclaw"
  echo "  ai-stack stop webui"
  echo "  ai-stack code         # ollama + opencode"
}

# ── Detección ──────────────────────────────────────────────────────────────
ollama_online()   { curl -sf "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; }
ollama_running()  { rc-service ollama status >/dev/null 2>&1; }
openclaw_active() { pgrep -af "openclaw-gateway" >/dev/null 2>&1; }
webui_active()    { rc-service open-webui status >/dev/null 2>&1; }
opencode_active() { pgrep -x "opencode" >/dev/null 2>&1; }

# ── Funciones de estado (coloreado) ────────────────────────────────────────
st_ollama() {
  if ollama_online; then echo -e "${G}ACTIVO${RST} ($OLLAMA_HOST)"; return 0
  elif ollama_running; then echo -e "${Y}INICIANDO${RST} (service up, API no responde)"; return 2
  else echo -e "${R}DETENIDO${RST}"; return 1; fi
}

st_openclaw() {
  if openclaw_active; then
    local port=""
    ss -tlnp 2>/dev/null | grep -q :19000 && port=" :19000"
    echo -e "${G}ACTIVO${RST}${port}"
    return 0
  else
    echo -e "${R}DETENIDO${RST}"; return 1
  fi
}

st_webui() {
  if webui_active; then echo -e "${G}ACTIVO${RST} (http://localhost:8080)"; return 0
  else echo -e "${R}DETENIDO${RST}"; return 1; fi
}

st_opencode() {
  if opencode_active; then echo -e "${G}CORRIENDO${RST}"; return 0
  else echo -e "${D}no iniciado${RST}"; return 1; fi
}

# ── Mostrar estado completo ────────────────────────────────────────────────
show_status() {
  echo -e "  ${B}Ollama${RST}     $(st_ollama)"
  echo -e "  ${B}OpenClaw${RST}   $(st_openclaw)"
  echo -e "  ${B}Web UI${RST}     $(st_webui)"
  echo -e "  ${B}OpenCode${RST}   $(st_opencode)"
}

# ── Listar modelos Ollama ──────────────────────────────────────────────────
list_models() {
  local fmt="${1:-name}"  # name | full
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 no disponible — no se pueden listar modelos"
    return 1
  fi
  curl -sf "$OLLAMA_HOST/api/tags" 2>/dev/null | python3 -c "
import json,sys
data=json.load(sys.stdin)
models = data.get('models', [])
if not models:
    print('    (ningún modelo descargado)')
    sys.exit(0)
for m in models:
    name = m['name']
    size = m.get('size', 0) / 1e9
    if '$fmt' == 'full':
        print(f'    {name:30s} {size:.1f}GB')
    else:
        print(f'    {name}')
" 2>/dev/null || warn "No se pudieron obtener los modelos de Ollama"
}

show_status_box() {
  title "Estado del stack" "ai-stack status"
  show_status
  if ollama_online; then
    echo
    echo -e "  ${D}Modelos Ollama:${RST}"
    list_models full
  fi
  echo
}

# ── Acciones sobre servicios ───────────────────────────────────────────────
start_svc_ollama() {
  if ollama_online; then ok "Ollama ya responde"; return; fi
  if ollama_running; then ok "Ollama ya iniciado (service)"; return; fi
  info "Iniciando Ollama..."
  sudo rc-service ollama start
  for i in $(seq 1 "$OLLAMA_READY_TIMEOUT"); do
    ollama_online && { ok "Ollama listo"; return; }
    sleep 1
  done
  err "Ollama no respondió tras ${OLLAMA_READY_TIMEOUT}s"
  return 1
}

stop_svc_ollama() {
  if ! ollama_running && ! ollama_online; then
    warn "Ollama ya está detenido"; return
  fi
  info "Deteniendo Ollama..."
  sudo rc-service ollama stop || true

  # Esperar hasta 30s a que realmente termine (los modelos en GPU tardan en descargarse)
  for i in $(seq 1 30); do
    if ! ollama_running && ! ollama_online; then
      ok "Ollama detenido"; return
    fi
    if [ "$i" -eq 15 ]; then
      warn "Ollama no termina — forzando llama-server..."
      sudo pkill -f "llama-server" 2>/dev/null || true
    fi
    sleep 1
  done

  if ollama_running || ollama_online; then
    err "Ollama no se detuvo después de 30s"
    info "Podés verificar con: sudo rc-service ollama status"
    info "Y forzar con: sudo pkill -9 -f ollama"
    return 1
  fi
  ok "Ollama detenido"
}

start_svc_openclaw() {
  if openclaw_active; then ok "OpenClaw gateway ya corre"; return; fi

  if ! command -v openclaw >/dev/null 2>&1; then
    err "openclaw no encontrado en PATH — instalalo o revisa tu configuración"
    return 1
  fi

  info "Iniciando OpenClaw gateway (puerto 19000)..."
  mkdir -p "$HOME/.local/state"
  nohup openclaw gateway run --port 19000 >/dev/null 2>"$HOME/.local/state/ai-stack-openclaw.log" &
  disown
  for i in $(seq 1 15); do
    if ss -tlnp 2>/dev/null | grep -q :19000; then
      ok "OpenClaw gateway listo (:19000)"; return
    fi
    sleep 1
  done
  warn "OpenClaw no responde en :19000 tras 15s — revisa ~/.local/state/ai-stack-openclaw.log"
}

stop_svc_openclaw() {
  if ! openclaw_active; then warn "OpenClaw ya está detenido"; return; fi
  info "Deteniendo OpenClaw gateway..."
  pkill -f "openclaw-gateway" 2>/dev/null || true
  ok "OpenClaw gateway detenido"
}

start_svc_webui() {
  if webui_active; then ok "Open WebUI ya corre"; return; fi
  info "Iniciando Open WebUI..."
  sudo rc-service open-webui start
  ok "Open WebUI iniciado (http://localhost:8080)"
}

stop_svc_webui() {
  if ! webui_active; then warn "Open WebUI ya está detenido"; return; fi
  info "Deteniendo Open WebUI..."
  sudo rc-service open-webui stop 2>/dev/null || true
  ok "Open WebUI detenido"
}

start_svc_opencode() {
  mkdir -p "$AUTH_DIR" "$CONFIG_DIR"

  # auth.json: crear por defecto solo si no existe (no sobrescribir)
  if [ ! -f "$AUTH_DIR/auth.json" ]; then
    echo '{"ollama":{"type":"api","key":"ollama"}}' > "$AUTH_DIR/auth.json"
    info "auth.json creado con proveedor ollama por defecto"
  fi

  # Clipboard sync: evitar duplicados
  if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-paste >/dev/null 2>&1; then
    if pgrep -f "wl-paste.*watch" >/dev/null 2>&1; then
      info "Clipboard sync ya activo"
    else
      wl-paste --watch wl-copy --primary &
      CLIP_SYNC_PID=$!
      info "Clipboard sync activo"
    fi
  fi

  "$OPENCODE_BIN"
  OPENCODE_EXIT=$?

  # limpiar clipboard sync al cerrar opencode
  [ -n "$CLIP_SYNC_PID" ] && kill "$CLIP_SYNC_PID" 2>/dev/null || true

  # Resetear terminal por si opencode dejó raw mode activo
  stty sane 2>/dev/null || true

  return $OPENCODE_EXIT
}

# ── Renovar token MCP de OpenClaw ───────────────────────────────────────────
do_renew() {
  info "Renovando grant MCP de OpenClaw..."
  if ! command -v openclaw >/dev/null 2>&1; then
    err "openclaw no encontrado en PATH"
    return 1
  fi

  local grant token config
  grant=$(openclaw attach --print-config --ttl 86400000 2>&1)
  token=$(echo "$grant" | python3 -c "import json,sys; print(json.load(sys.stdin)['env']['OPENCLAW_MCP_TOKEN'])" 2>/dev/null) || {
    err "No se pudo obtener el token MCP — ¿openclaw está corriendo y autenticado?"
    return 1
  }

  config="$HOME/.config/opencode/opencode.json"
  if [ -f "$config" ]; then
    cp "$config" "$config.bak"
    python3 -c "
import json
with open('$config') as f:
    d = json.load(f)
d.setdefault('mcp', {})['openclaw'] = {
    'enabled': True,
    'type': 'http',
    'url': 'http://127.0.0.1:39051/mcp',
    'headers': {'Authorization': 'Bearer $token'}
}
with open('$config', 'w') as f:
    json.dump(d, f, indent=2)
" && ok "openclaw.json actualizado con nuevo token"
  fi

  ok "MCP grant renovado (token: ${token:0:16}...)"
}

# ── Router start/stop/restart ──────────────────────────────────────────────
do_start() {
  case "$1" in
    ollama)   start_svc_ollama   ;;
    openclaw) start_svc_openclaw ;;
    webui)    start_svc_webui    ;;
    opencode) start_svc_opencode ;;
    all)      start_svc_ollama; start_svc_openclaw; start_svc_webui ;;
    *) err "Servicio inválido: $1 (ollama|openclaw|webui|opencode|all)"; return 1 ;;
  esac
}

do_stop() {
  case "$1" in
    ollama)   stop_svc_ollama   ;;
    openclaw) stop_svc_openclaw ;;
    webui)    stop_svc_webui    ;;
    opencode) err "OpenCode se detiene al cerrar su interfaz";;
    all)      stop_svc_openclaw; stop_svc_webui; stop_svc_ollama; ok "Todo detenido" ;;
    *) err "Servicio inválido: $1 (ollama|openclaw|webui|all)"; return 1 ;;
  esac
}

do_restart() {
  info "Reiniciando $1..."
  do_stop "$1" 2>/dev/null; sleep 1
  do_start "$1"
}

# ── Menú simplificado (legacy manage-ai.sh) ───────────────────────────────────
legacy_menu() {
  # Menú con select al estilo del manage-ai.sh original, usando funciones de ai-stack
  while true; do
    clear
    echo "--- Estatus actual ---"
    for svc in ollama open-webui; do
      if sudo rc-service "$svc" status >/dev/null 2>&1; then
        echo "  [RUNNING] $svc"
      else
        echo "  [STOPPED] $svc"
      fi
    done
    echo "----------------------"
    echo "Seleccione una accion:"
    options=("Iniciar servicios" "Detener servicios y salir" "Salir")
    select opt in "${options[@]}"; do
      case $opt in
        "Iniciar servicios")
          start_svc_ollama
          start_svc_webui
          break
          ;;
        "Detener servicios y salir")
          stop_svc_webui 2>/dev/null
          stop_svc_ollama
          exit 0
          ;;
        "Salir")
          exit 0
          ;;
        *) echo "Opcion invalida" ;;
      esac
    done
  done
}

# ── Menú interactivo ───────────────────────────────────────────────────────
interactive_menu() {
  # cleanup al salir con Ctrl+C
  trap 'stty sane 2>/dev/null; echo; warn "Interrupción"; exit 0' SIGINT SIGTERM

  while true; do
    clear
    echo -e "${B}╔════════════════════════════════════════╗${RST}"
    echo -e "${B}║       ai-stack — Stack AI              ║${RST}"
    echo -e "${B}╚════════════════════════════════════════╝${RST}"
    echo
    echo -e "  ${D}Estado actual:${RST}"
    echo -e "    Ollama     $(st_ollama)"
    echo -e "    OpenClaw   $(st_openclaw)"
    echo -e "    Web UI     $(st_webui)"
    echo -e "    OpenCode   $(st_opencode)"
    echo
    echo -e "  ${D}━━━ Acciones ━━━${RST}"
    echo -e "  ${B}1${RST})  Iniciar Ollama"
    echo -e "  ${B}2${RST})  Detener  Ollama"
    echo -e "  ${B}3${RST})  Iniciar OpenClaw"
    echo -e "  ${B}4${RST})  Detener  OpenClaw"
    echo -e "  ${B}5${RST})  Iniciar Web UI"
    echo -e "  ${B}6${RST})  Detener  Web UI"
    echo -e "  ${B}7${RST})  Lanzar OpenCode (con Ollama si es necesario)"
    echo
    echo -e "  ${B}8${RST})  Iniciar TODO"
    echo -e "  ${B}9${RST})  Detener TODO"
    echo
    echo -e "  ${M}0${RST})  Salir"
    echo
    read -rp "  Opción: " opt
    echo

    case "$opt" in
      1) start_svc_ollama   ;;
      2) stop_svc_ollama    ;;
      3) start_svc_openclaw ;;
      4) stop_svc_openclaw  ;;
      5) start_svc_webui    ;;
      6) stop_svc_webui     ;;
      7)
        # OpenCode: asegurar Ollama primero
        if ! ollama_online; then
          info "Ollama no está activo — iniciando..."
          start_svc_ollama
        fi
        # listar modelos antes de lanzar
        echo
        if ollama_online; then
          echo -e "  ${D}Modelos disponibles:${RST}"
          list_models
        fi
        echo
        start_svc_opencode
        echo
        info "OpenCode terminó. Presioná Enter para volver al menú."
        read -r
        ;;
      8)
        info "Iniciando TODO..."
        start_svc_ollama
        start_svc_openclaw
        start_svc_webui
        echo; ok "Stack completo activo"
        read -rp "  Presioná Enter para continuar... "
        ;;
      9)
        stop_svc_openclaw
        stop_svc_webui
        stop_svc_ollama
        echo; ok "Stack detenido"
        read -rp "  Presioná Enter para continuar... "
        ;;
      0)
        echo -e "  ${D}Salir.${RST}"
        echo
        exit 0
        ;;
      *)
        err "Opción inválida"
        sleep 1
        ;;
    esac
  done
}

# ── Parse ──────────────────────────────────────────────────────────────────
if [ $# -eq 0 ]; then
  interactive_menu
  exit 0
fi

case "$1" in
  status|estado)
    show_status_box
    ;;
  start)
    [ $# -lt 2 ] && { err "Falta servicio: ollama|openclaw|webui|opencode"; exit 1; }
    do_start "$2"
    ;;
  stop|detener)
    [ $# -lt 2 ] && { do_stop "all"; exit 0; }
    do_stop "$2"
    ;;
  restart|reiniciar)
    [ $# -lt 2 ] && { err "Falta servicio"; exit 1; }
    do_restart "$2"
    ;;
  code)
    title "Modo code" "Ollama + OpenCode"
    start_svc_ollama
    echo
    start_svc_opencode
    info "OpenCode terminó."
    ;;
  mcp)
    title "Modo mcp" "Ollama + OpenClaw"
    start_svc_ollama
    start_svc_openclaw
    echo; ok "MCP stack listo (http://localhost:19000)"
    ;;
  webui)
    title "Modo webui" "Ollama + Open WebUI"
    start_svc_ollama
    start_svc_webui
    echo; ok "Web UI lista (http://localhost:8080)"
    ;;
  full|todo)
    title "Modo full" "Stack completo"
    start_svc_ollama
    start_svc_openclaw
    start_svc_webui
    echo; ok "Stack completo activo"
    echo "   OpenClaw: http://localhost:19000"
    echo "   Web UI:   http://localhost:8080"
    echo
    info "Para OpenCode: ai-stack code"
    ;;
  legacy|simple)
    legacy_menu
    ;;
  renew|mcp-renew)
    do_renew
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    err "Comando desconocido: $1"
    echo "Usa 'ai-stack help' para ayuda"
    exit 1
    ;;
esac