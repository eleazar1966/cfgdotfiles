#!/usr/bin/env python3
import markdown
from weasyprint import HTML
import sys

with open(sys.argv[1], 'r') as f:
    md_content = f.read()

# Convert markdown to HTML
html_content = markdown.markdown(md_content, extensions=['tables', 'toc', 'fenced_code'])

# Add CSS for better PDF output
css = """
@page { margin: 2cm; size: A4; }
body { font-family: 'DejaVu Sans', sans-serif; font-size: 11pt; line-height: 1.5; }
h1 { color: #1a1a2e; border-bottom: 2px solid #1a1a2e; padding-bottom: 0.3em; page-break-before: always; }
h2 { color: #16213e; border-bottom: 1px solid #0f3460; padding-bottom: 0.2em; page-break-before: avoid; }
h3 { color: #0f3460; }
table { border-collapse: collapse; width: 100%; margin: 1em 0; page-break-inside: avoid; }
th, td { border: 1px solid #ccc; padding: 0.4em 0.6em; font-size: 9.5pt; }
th { background-color: #f0f0f0; font-weight: bold; }
code { background-color: #f5f5f5; padding: 0.1em 0.3em; font-family: 'DejaVu Sans Mono', monospace; font-size: 9pt; }
pre { background-color: #f5f5f5; padding: 0.8em; overflow-x: auto; page-break-inside: avoid; }
pre code { background: none; padding: 0; }
blockquote { border-left: 3px solid #0f3460; padding-left: 1em; color: #555; margin: 1em 0; }
ul, ol { margin: 0.5em 0 0.5em 2em; }
a { color: #0f3460; text-decoration: none; }
hr { border: none; border-top: 1px solid #ddd; margin: 2em 0; }
.toc { page-break-after: always; }
"""

full_html = f"""
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>{css}</style>
</head>
<body>
{html_content}
</body>
</html>
"""

HTML(string=full_html).write_pdf(sys.argv[2])
print(f"PDF generated: {sys.argv[2]}")
