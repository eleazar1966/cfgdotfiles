#!/bin/bash
# opencode — Launcher wrapper
# Arranca Ollama si no está corriendo, espera a que la API responda,
# crea auth.json placeholder si no existe, luego lanza opencode TUI.
set -e

OPCODE_BIN="/home/eleazar/.opencode/bin/opencode"
OLLAMA_SERVICE="ollama"
OLLAMA_API="http://localhost:11434"
AUTH_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/auth.json"
MAX_WAIT=15

# ── 0. TMPDIR: evitar noexec en /tmp (OpenCode extrae .so para la TUI) ──
export TMPDIR="${XDG_CACHE_HOME:-$HOME/.cache}/opencode-tmp"
mkdir -p "$TMPDIR"

# ── 1. Asegurar que Ollama esté corriendo ──
if ! rc-service "$OLLAMA_SERVICE" status >/dev/null 2>&1; then
    echo "🔄 Arrancando Ollama..."
    rc-service "$OLLAMA_SERVICE" start
fi

# ── 2. Esperar a que la API responda ──
echo -n "⏳ Esperando a Ollama..."
for i in $(seq 1 "$MAX_WAIT"); do
    if curl -sf "$OLLAMA_API/api/tags" >/dev/null 2>&1; then
        echo " listo."
        break
    fi
    if [ "$i" -eq "$MAX_WAIT" ]; then
        echo " ERROR: Ollama no respondió después de ${MAX_WAIT}s."
        echo "   Verifica con: rc-service ollama status"
        exit 1
    fi
    echo -n "."
    sleep 1
done

# ── 3. Crear auth.json placeholder si no existe ──
if [ ! -f "$AUTH_FILE" ]; then
    AUTH_DIR="$(dirname "$AUTH_FILE")"
    mkdir -p "$AUTH_DIR"
    cat > "$AUTH_FILE" <<- 'EOF'
{
  "provider": "ollama",
  "note": "Placeholder — opencode lo gestiona automáticamente"
}
EOF
fi

# ── 4. Lanzar opencode TUI ──
exec "$OPCODE_BIN" "$@"
