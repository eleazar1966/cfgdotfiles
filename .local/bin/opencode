#!/bin/bash
# opencode + Ollama auto-detect launcher for Gentoo Linux
# Detects all installed Ollama models via plugin and launches opencode

OPENCODE_BIN="${OPENCODE_BIN:-$HOME/.opencode/bin/opencode}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
AUTH_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/opencode"
OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"

# 1. Ensure Ollama is running (Gentoo OpenRC)
if ! rc-service ollama status >/dev/null 2>&1; then
  echo "-> Starting Ollama..."
  sudo rc-service ollama start
fi

# 2. Wait for Ollama API
echo -n "-> Waiting for Ollama API"
for i in $(seq 1 15); do
  if curl -sf "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
    echo " ready"
    break
  fi
  echo -n "."
  sleep 1
done
echo ""

# 3. Ensure auth placeholder exists (required by opencode for local providers)
mkdir -p "$AUTH_DIR"
if [ ! -f "$AUTH_DIR/auth.json" ]; then
  echo '{"ollama":{"type":"api","key":"ollama"}}' > "$AUTH_DIR/auth.json"
fi

# 4. Ensure global config dir exists with plugin reference
mkdir -p "$CONFIG_DIR"

# 5. Show available models
echo "-> Models instalados en Ollama:"
curl -sf "$OLLAMA_HOST/api/tags" 2>/dev/null | \
  python3 -c "import json,sys; data=json.load(sys.stdin); [print(f'   {m[\"name\"]:30s} {m[\"size\"]/1e9:.1f}GB') for m in data.get('models',[])]" \
  2>/dev/null || echo "   (no se pudo listar modelos)"

# 6. Clipboard → primary selection sync (para clic central con copy_on_select)
CLIP_SYNC_PID=""
if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-paste >/dev/null 2>&1; then
  echo "-> Iniciando sync clipboard → primary selection..."
  wl-paste --watch wl-copy --primary &
  CLIP_SYNC_PID=$!
fi

# 7. Capturar interrupción para apagar servicios
cleanup() {
  echo ""
  echo "-> Limpiando servicios..."
  [ -n "$CLIP_SYNC_PID" ] && kill "$CLIP_SYNC_PID" 2>/dev/null
  sudo rc-service ollama stop 2>/dev/null || true
  exit 0
}
trap cleanup SIGINT SIGTERM SIGHUP

# 8. Launch opencode
echo "-> Iniciando opencode..."
"$OPENCODE_BIN"
OPENCODE_EXIT=$?

# 9. Stop services when opencode exits
echo "-> Limpiando servicios..."
[ -n "$CLIP_SYNC_PID" ] && kill "$CLIP_SYNC_PID" 2>/dev/null
sudo rc-service ollama stop 2>/dev/null || true

exit $OPENCODE_EXIT
