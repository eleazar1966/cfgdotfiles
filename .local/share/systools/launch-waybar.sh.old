#!/bin/bash

# 1. Cerrar Waybar de forma elegante
# Usamos SIGTERM para que guarde configuraciones y cierre hilos limpiamente
killall -q waybar

# 2. Esperar a que el proceso realmente muera
while pgrep -u $USER -x waybar >/dev/null; do sleep 0.1; done

# 3. Reiniciar con logs redirigidos a la nada para evitar bloqueos por buffer
# Usamos 'setsid' para que el proceso sea independiente de la terminal
setsid waybar >/dev/null 2>&1 &

# 4. Notificación opcional (puedes borrar esta línea)
notify-send "Waybar" "Reiniciado con éxito" -i utilities-terminal
